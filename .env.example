NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SITE_URL=https://YOUR_DOMAIN

# Google Analytics 4 — Measurement ID público (G-XXXXXXXXXX). Vacío = GA4 desactivado.
# Solo se carga tras el consentimiento analítico (Consent Mode v2, modo básico).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console — valor "content" de la meta etiqueta de verificación (opcional;
# se recomienda verificar la propiedad de dominio por DNS).
GOOGLE_SITE_VERIFICATION=
